# Copy to .env.production.local for local production builds.
# On Cloudflare Pages, set these as project environment variables instead.
VITE_SPACETIMEDB_URI=wss://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DB=verbs-quest

# Public Google OAuth 2.0 Web client ID for "Sign in with Google".
# This is NOT a secret (the client secret is never used in the browser flow).
# Leave empty to hide the Google button. Must match GOOGLE_CLIENT_ID in
# spacetimedb/src/lib.rs.
VITE_GOOGLE_CLIENT_ID=
