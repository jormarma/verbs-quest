{
  "name": "verbs-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "tsc -b && vite build --mode production",
    "deploy:cloudflare": "pnpm build:prod && npx wrangler pages deploy dist --project-name=verbs-quest --branch=main",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm test && pnpm build && pnpm verbs:verify:smoke",
    "test:rust": "cargo test --manifest-path spacetimedb/Cargo.toml",
    "preview": "vite preview",
    "verbs:import:dry": "node scripts/import-verbs-csv.mjs",
    "verbs:import": "node scripts/import-verbs-csv.mjs --execute",
    "verbs:verify:smoke": "node scripts/verify-admin-verbs-smoke.mjs",
    "stdb:build": "spacetime build --module-path ./spacetimedb",
    "stdb:publish:local": "spacetime publish verbs-quest --module-path ./spacetimedb --server local --delete-data=always --yes",
    "stdb:publish:maincloud": "spacetime publish verbs-quest --module-path ./spacetimedb --delete-data=always --yes",
    "stdb:generate": "spacetime generate --lang typescript --out-dir ./src/lib/spacetime/module_bindings --module-path ./spacetimedb verbs-quest"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "spacetimedb": "^2.6.0",
    "tailwind-merge": "^3.5.0",
    "three": "0.182.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.24",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0-beta.13",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.9",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}