{
  "name": "verbs-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "tsc -b && vite build --mode production",
    "deploy:cloudflare": "pnpm build:prod && npx wrangler pages deploy dist --project-name=verbs-quest --branch=main",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm test && pnpm build && pnpm verbs:verify:smoke",
    "test:rust": "cargo test --manifest-path spacetimedb/Cargo.toml",
    "preview": "vite preview",
    "verbs:import:dry": "node scripts/import-verbs-csv.mjs",
    "verbs:import": "node scripts/import-verbs-csv.mjs --execute",
    "verbs:verify:smoke": "node scripts/verify-admin-verbs-smoke.mjs",
    "stdb:build": "spacetime build --module-path ./spacetimedb",
    "stdb:publish:local": "spacetime publish verbs-quest --module-path ./spacetimedb --server local --delete-data=always --yes",
    "stdb:publish:maincloud": "spacetime publish verbs-quest --module-path ./spacetimedb --delete-data=always --yes",
    "stdb:generate": "spacetime generate --lang typescript --out-dir ./src/lib/spacetime/module_bindings --module-path ./spacetimedb verbs-quest"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "spacetimedb": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "three": "0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "vite": "^8.3.4"
  }
}
